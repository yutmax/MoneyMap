# Скопировать в .env и заполнить. Файл .env в git не попадает.

NODE_ENV=development
LOG_LEVEL=debug

# ───────────────────────────────── API ──────────────────────────────────
HOST=127.0.0.1
PORT=5000

# Для разработки подходит как есть — compose.dev.yml поднимает ровно эту БД.
DATABASE_URL=postgres://moneymap:moneymap@localhost:5432/moneymap

# Ключ подписи access-токенов. Минимум 32 символа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=замените_на_случайную_строку_минимум_32_символа

# Origin фронтенда: CORS и проверка Origin при защите от CSRF.
# Несколько значений — через запятую.
WEB_ORIGIN=http://localhost:5173
# Базовый адрес для ссылок в письмах.
PUBLIC_WEB_URL=http://localhost:5173

# В production обязательно true: refresh-кука выставляется с флагом Secure,
# без TLS аутентификация просто не работает.
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=60

# Проверка пароля по базе утечек (k-anonymity, api.pwnedpasswords.com).
# Выключить, если нет исходящей сети.
PASSWORD_BREACH_CHECK=true

# ─────────────────────────── фоновые задачи ─────────────────────────────
# Загрузка курсов и снимки net worth (§8.5, §8.6). В dev обычно не нужны:
# курсы заливаются вручную `pnpm --filter @moneymap/api db:rates`.
JOBS_ENABLED=false
# Расписание в UTC. Курсы — ночью, снимки — после них.
# RATES_CRON=15 3 * * *
# SNAPSHOTS_CRON=45 3 * * *
# RATES_TIMEOUT_MS=10000

# ──────────────────────── только для compose.prod.yml ───────────────────
# Адрес приложения целиком, со схемой и портом. Он же идёт в Caddy, в CORS
# и в ссылки писем, поэтому значение одно на всех — расхождение между ними
# ломает либо сертификат, либо проверку Origin.
#
# 443 на сервере занят OpenVPN, отсюда 8443.
#
# Имя, а не IP: по IP сертификат может быть только самоподписанный, а с ним
# браузер считает сайт незащищённым — не регистрирует service worker и не
# предлагает установку на домашний экран. Домена нет, поэтому взято
# «IP с дефисами».nip.io — такое имя резолвится в сам IP, и Let's Encrypt
# выдаёт на него обычный сертификат по HTTP-01 через свободный порт 80.
# SITE_ADDRESS=https://77-239-97-120.nip.io:8443
# Тот же хост без схемы и порта — Caddy подставляет его в редирект с HTTP
# и в default_sni. Значения обязаны совпадать, меняются вместе.
# SITE_HOST=77-239-97-120.nip.io
# WEB_ORIGIN=https://77-239-97-120.nip.io:8443
# PUBLIC_WEB_URL=https://77-239-97-120.nip.io:8443
# POSTGRES_USER=moneymap
# POSTGRES_PASSWORD=
# POSTGRES_DB=moneymap

# ───────────────────────── порты хоста для compose.dev.yml ───────────────
# Переопределить, если 5432 или 8081 заняты (например, локально установлен
# Postgres). DATABASE_URL выше должен указывать на тот же порт.
# POSTGRES_PORT=5433
# PGWEB_PORT=8081
