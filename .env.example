# Скопировать в .env и заполнить. Файл .env в git не попадает.

NODE_ENV=development
LOG_LEVEL=debug

# ───────────────────────────────── API ──────────────────────────────────
HOST=127.0.0.1
PORT=5000

# Для разработки подходит как есть — compose.dev.yml поднимает ровно эту БД.
DATABASE_URL=postgres://moneymap:moneymap@localhost:5432/moneymap

# Ключ подписи access-токенов. Минимум 32 символа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=замените_на_случайную_строку_минимум_32_символа

# Origin фронтенда: CORS и проверка Origin при защите от CSRF.
# Несколько значений — через запятую.
WEB_ORIGIN=http://localhost:5173
# Базовый адрес для ссылок в письмах.
PUBLIC_WEB_URL=http://localhost:5173

# В production обязательно true: refresh-кука выставляется с флагом Secure,
# без TLS аутентификация просто не работает.
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=60

# Проверка пароля по базе утечек (k-anonymity, api.pwnedpasswords.com).
# Выключить, если нет исходящей сети.
PASSWORD_BREACH_CHECK=true

# ──────────────────────── только для compose.prod.yml ───────────────────
# Адрес приложения целиком, со схемой и портом. Он же идёт в Caddy, в CORS
# и в ссылки писем, поэтому значение одно на всех — расхождение между ними
# ломает либо сертификат, либо проверку Origin.
#
# 443 на сервере занят OpenVPN, отсюда 8443. По IP Caddy выпустит
# самоподписанный сертификат; с настоящим доменом — возьмёт Let's Encrypt.
# SITE_ADDRESS=https://77.239.97.120:8443
# Тот же хост без схемы и порта. Нужен Caddy отдельно: клиент, обращающийся
# по IP, не передаёт SNI (для IP-адресов его не существует), и без этой
# подсказки Caddy не знает, какой сертификат предъявить. Значения обязаны
# совпадать — меняются вместе.
# SITE_HOST=77.239.97.120
# WEB_ORIGIN=https://77.239.97.120:8443
# PUBLIC_WEB_URL=https://77.239.97.120:8443
# POSTGRES_USER=moneymap
# POSTGRES_PASSWORD=
# POSTGRES_DB=moneymap

# ───────────────────────── порты хоста для compose.dev.yml ───────────────
# Переопределить, если 5432 или 8081 заняты (например, локально установлен
# Postgres). DATABASE_URL выше должен указывать на тот же порт.
# POSTGRES_PORT=5433
# PGWEB_PORT=8081
